# G015 — reference FASTA fed to a VCF consumer
# A FASTA producer feeds a consumer whose declared contract is VCF.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g015"

[[rules]]
name = "produce"
output = ["genome.fa"]
shell = "samtools faidx genome.fa"
[rules.types]
outputs = { default = "FASTA" }

[[rules]]
name = "consume"
input = ["genome.fa"]
output = ["result.dat"]
shell = "bcftools norm -f genome.fa calls.vcf > norm.vcf"
[rules.types]
inputs = { default = "VCF" }
