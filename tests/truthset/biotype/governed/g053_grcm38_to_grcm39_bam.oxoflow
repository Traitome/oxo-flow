# G053 — GRCm38 BAM fed to a GRCm39 consumer
# The producer declares reference_build=GRCm38; the consumer requires
# reference_build=GRCm39. The published reference-build field is checked
# when both sides name a build and aliases do not make these equal, so
# the edge violates TYPE-004. This build pair was not asserted by any
# pilot case (the pilot used the human GRCh37/GRCh38 family).
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-004.

[workflow]
name = "g053"

[[rules]]
name = "produce"
output = ["aln.bam"]
shell = "bwa mem grcm38.fa r1.fq r2.fq | samtools sort -o aln.bam"
[rules.types]
outputs = { default = "BAM[sort_order=coordinate,reference_build=GRCm38]" }

[[rules]]
name = "consume"
input = ["aln.bam"]
output = ["result.txt"]
shell = "gatk HaplotypeCaller -R grcm39.fa -I aln.bam -O calls.vcf.gz"
[rules.types]
inputs = { default = "BAM[sort_order=coordinate,reference_build=GRCm39]" }
