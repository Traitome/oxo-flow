# G001 — BAM alignment fed to a text-VCF consumer
# A BAM producer feeds a consumer whose declared contract is VCF.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g001"

[[rules]]
name = "produce"
output = ["sample.bam"]
shell = "bwa mem ref.fa r1.fq r2.fq | samtools sort -o sample.bam"
[rules.types]
outputs = { default = "BAM" }

[[rules]]
name = "consume"
input = ["sample.bam"]
output = ["result.dat"]
shell = "gatk HaplotypeCaller -I sample.bam -O calls.vcf"
[rules.types]
inputs = { default = "VCF" }
