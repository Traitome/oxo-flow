# G028 — SAM alignment fed to a BED consumer
# A SAM producer feeds a consumer whose declared contract is BED.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g028"

[[rules]]
name = "produce"
output = ["aln.sam"]
shell = "bwa mem ref.fa reads.fq > aln.sam"
[rules.types]
outputs = { default = "SAM" }

[[rules]]
name = "consume"
input = ["aln.sam"]
output = ["result.dat"]
shell = "bedtools bamtobed -i aln.sam > aln.bed"
[rules.types]
inputs = { default = "BED" }
