# G070 — BAM (BGZF by specification) fed to a zstd consumer
# The producer declares BAM; the consumer requires BAM[compression=zstd].
# The published compression field names block/stream encodings; only
# BAM implies BGZF, and a different declared encoding does not satisfy
# the requirement, so the edge violates TYPE-006. This compression
# pair was not asserted by the pilot.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-006.

[workflow]
name = "g070"

[[rules]]
name = "produce"
output = ["aln.bam"]
shell = "samtools sort -o aln.bam in.bam"
[rules.types]
outputs = { default = "BAM" }

[[rules]]
name = "consume"
input = ["aln.bam"]
output = ["result.dat"]
shell = "zstd -c aln.bam > aln.bam.zst"
[rules.types]
inputs = { default = "BAM[compression=zstd]" }
