# G014 — reference FASTA fed to an aligned-BAM consumer
# A FASTA producer feeds a consumer whose declared contract is BAM.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g014"

[[rules]]
name = "produce"
output = ["genome.fa"]
shell = "samtools faidx genome.fa"
[rules.types]
outputs = { default = "FASTA" }

[[rules]]
name = "consume"
input = ["genome.fa"]
output = ["result.dat"]
shell = "samtools view -b genome.fa > genome.bam"
[rules.types]
inputs = { default = "BAM" }
