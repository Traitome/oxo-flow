# G033 — VCF calls fed to a GTF consumer
# A VCF producer feeds a consumer whose declared contract is GTF.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g033"

[[rules]]
name = "produce"
output = ["calls.vcf"]
shell = "bcftools call -Ov -o calls.vcf"
[rules.types]
outputs = { default = "VCF" }

[[rules]]
name = "consume"
input = ["calls.vcf"]
output = ["result.dat"]
shell = "vep -i calls.vcf --gtf > annotated.gtf"
[rules.types]
inputs = { default = "GTF" }
