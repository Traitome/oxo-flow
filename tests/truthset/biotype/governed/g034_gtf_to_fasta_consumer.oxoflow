# G034 — GTF annotation fed to a FASTA consumer
# A GTF producer feeds a consumer whose declared contract is FASTA.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g034"

[[rules]]
name = "produce"
output = ["genes.gtf"]
shell = "stringtie -o genes.gtf aln.bam"
[rules.types]
outputs = { default = "GTF" }

[[rules]]
name = "consume"
input = ["genes.gtf"]
output = ["result.dat"]
shell = "gffread genes.gtf -g genome.fa -w transcripts.fa"
[rules.types]
inputs = { default = "FASTA" }
