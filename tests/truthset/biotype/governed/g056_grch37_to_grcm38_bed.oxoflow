# G056 — GRCh37 BED fed to a GRCm38 consumer
# The producer declares reference_build=GRCh37; the consumer requires
# reference_build=GRCm38. The published reference-build field is checked
# when both sides name a build and aliases do not make these equal, so
# the edge violates TYPE-004. This build pair was not asserted by any
# pilot case (the pilot used the human GRCh37/GRCh38 family).
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-004.

[workflow]
name = "g056"

[[rules]]
name = "produce"
output = ["peaks.bed"]
shell = "macs2 callpeak -t aln.bam -f BAM -g hs"
[rules.types]
outputs = { default = "BED[reference_build=GRCh37]" }

[[rules]]
name = "consume"
input = ["peaks.bed"]
output = ["result.txt"]
shell = "bedtools intersect -a peaks.bed -b grcm38_genes.bed"
[rules.types]
inputs = { default = "BED[reference_build=GRCm38]" }
