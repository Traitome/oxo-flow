# G012 — GTF annotation fed to a GFF3 consumer
# A GTF producer feeds a consumer whose declared contract is GFF3.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g012"

[[rules]]
name = "produce"
output = ["genes.gtf"]
shell = "stringtie -o genes.gtf aln.bam"
[rules.types]
outputs = { default = "GTF" }

[[rules]]
name = "consume"
input = ["genes.gtf"]
output = ["result.dat"]
shell = "agat_convert_sp_gff2gtf.pl genes.gtf > genes.gff3"
[rules.types]
inputs = { default = "GFF3" }
