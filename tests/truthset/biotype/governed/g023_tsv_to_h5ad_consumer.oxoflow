# G023 — TSV counts fed to an H5AD consumer
# A TSV producer feeds a consumer whose declared contract is H5AD.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g023"

[[rules]]
name = "produce"
output = ["counts.tsv"]
shell = "cut -f1,2 counts.tsv > counts.tsv"
[rules.types]
outputs = { default = "TSV" }

[[rules]]
name = "consume"
input = ["counts.tsv"]
output = ["result.dat"]
shell = "python -c 'import anndata; anndata.read_csv(\"counts.tsv\").write_h5ad(\"counts.h5ad\")'"
[rules.types]
inputs = { default = "H5AD" }
