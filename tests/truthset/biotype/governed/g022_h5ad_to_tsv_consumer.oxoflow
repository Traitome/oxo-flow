# G022 — H5AD object fed to a TSV consumer
# A H5AD producer feeds a consumer whose declared contract is TSV.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g022"

[[rules]]
name = "produce"
output = ["matrix.h5ad"]
shell = "scanpy write matrix.h5ad"
[rules.types]
outputs = { default = "H5AD" }

[[rules]]
name = "consume"
input = ["matrix.h5ad"]
output = ["result.dat"]
shell = "python -c 'import scanpy; scanpy.read_h5ad(\"matrix.h5ad\").obs.to_csv(\"obs.tsv\", sep=\"\\t\")'"
[rules.types]
inputs = { default = "TSV" }
