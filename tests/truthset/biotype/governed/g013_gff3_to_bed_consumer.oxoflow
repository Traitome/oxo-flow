# G013 — GFF3 annotation fed to a BED consumer
# A GFF3 producer feeds a consumer whose declared contract is BED.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g013"

[[rules]]
name = "produce"
output = ["genes.gff3"]
shell = "prokka --outdir . genome.fa"
[rules.types]
outputs = { default = "GFF3" }

[[rules]]
name = "consume"
input = ["genes.gff3"]
output = ["result.dat"]
shell = "bedtools sort -i genes.gff3 > genes.bed"
[rules.types]
inputs = { default = "BED" }
