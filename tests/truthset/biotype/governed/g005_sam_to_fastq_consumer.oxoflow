# G005 — SAM alignment fed to a FASTQ consumer
# A SAM producer feeds a consumer whose declared contract is FASTQ.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g005"

[[rules]]
name = "produce"
output = ["aln.sam"]
shell = "bwa mem ref.fa reads.fq > aln.sam"
[rules.types]
outputs = { default = "SAM" }

[[rules]]
name = "consume"
input = ["aln.sam"]
output = ["result.dat"]
shell = "seqtk seq aln.sam > reads.fq"
[rules.types]
inputs = { default = "FASTQ" }
