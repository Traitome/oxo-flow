# G032 — raw FASTQ fed to a VCF consumer
# A FASTQ producer feeds a consumer whose declared contract is VCF.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g032"

[[rules]]
name = "produce"
output = ["reads.fq"]
shell = "trimmomatic PE r1.fq r2.fq > reads.fq"
[rules.types]
outputs = { default = "FASTQ" }

[[rules]]
name = "consume"
input = ["reads.fq"]
output = ["result.dat"]
shell = "bcftools mpileup -f ref.fa reads.fq > calls.vcf"
[rules.types]
inputs = { default = "VCF" }
