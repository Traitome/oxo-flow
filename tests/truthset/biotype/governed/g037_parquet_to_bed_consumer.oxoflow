# G037 — PARQUET intervals fed to a BED consumer
# A PARQUET producer feeds a consumer whose declared contract is BED.
# The published format enum makes them distinct formats; no coercion
# arm applies, so the edge violates TYPE-001 (format incompatibility).
# Distinct format pair not asserted by any pilot case.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-001.

[workflow]
name = "g037"

[[rules]]
name = "produce"
output = ["regions.parquet"]
shell = "Rscript -e 'arrow::write_parquet(df, \"regions.parquet\")'"
[rules.types]
outputs = { default = "PARQUET" }

[[rules]]
name = "consume"
input = ["regions.parquet"]
output = ["result.dat"]
shell = "Rscript -e 'write.table(arrow::read_parquet(\"regions.parquet\"), \"regions.bed\", sep=\"\\t\", quote=FALSE)'"
[rules.types]
inputs = { default = "BED" }
