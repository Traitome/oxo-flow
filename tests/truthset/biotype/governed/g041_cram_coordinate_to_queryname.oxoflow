# G041 — coordinate-sorted CRAM fed to a queryname consumer
# The producer declares CRAM[sort_order=coordinate]; the consumer
# requires CRAM[sort_order=queryname]. The published sort-order field
# is a consumer requirement, and a different recorded order does not
# satisfy it, so the edge violates TYPE-002. The pilot asserted only
# BAM queryname<->coordinate, so this format/order pair is new.
#
# EXPECTED (authored 2026-11-27 from the published contract, before running):
#   reject — TYPE-002.

[workflow]
name = "g041"

[[rules]]
name = "produce"
output = ["aln.cram"]
shell = "samtools view -C -o aln.cram aln.bam"
[rules.types]
outputs = { default = "CRAM[sort_order=coordinate]" }

[[rules]]
name = "consume"
input = ["aln.cram"]
output = ["result.txt"]
shell = "samtools fixmate -m aln.cram fixed.cram"
[rules.types]
inputs = { default = "CRAM[sort_order=queryname]" }
