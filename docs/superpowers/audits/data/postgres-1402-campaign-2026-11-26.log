===== probe 5: PostgreSQL SIGKILL crash during an uncommitted transaction =====
# command: bash ~/probe1402-scripts/crash.sh  (systemctl kill -s SIGKILL postgresql@16-main)
WEB_PID=986608
CHAIN_BEFORE=0:0000000000000000
RUN_ID=5658c11b-aee8-476a-80a4-9b30592285fd
